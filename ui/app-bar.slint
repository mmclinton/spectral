// The window's top chrome: wordmark, status pill, and external links.

import { Theme } from "theme.slint";
import { ClickableLink } from "links.slint";

component StatusPill inherits Rectangle {
    in property <string> label;
    in property <color> pill_color;
    in property <bool> enabled_look;

    height: 26px;
    horizontal-stretch: 0;
    background: Theme.inset;
    border-color: root.pill_color;
    border-width: 1px;
    border-radius: self.height / 2;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.pill_color;
            }
        }

        Text {
            text: root.label;
            font-size: Theme.font_caption;
            font-weight: 700;
            color: root.enabled_look ? white : Theme.text_muted;
            vertical-alignment: center;
        }
    }
}

// StatusPill's geometry in the error accent, plus a click target. It renders
// only while an error is present, so it must not disturb the pill beside it:
// the bar's height is fixed and the chip sits before the stretch spacer, so
// appearing and disappearing costs no reflow.
component ErrorChip inherits Rectangle {
    callback clicked();

    height: 26px;
    horizontal-stretch: 0;
    background: touch.has-hover ? Theme.border_subtle : Theme.inset;
    border-color: Theme.error;
    border-width: 1px;
    border-radius: self.height / 2;

    // Slint's AccessibleRole has no link variant; button is the closest
// behavior match.
    accessible-role: button;
    accessible-label: "Error — show details";
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.error;
            }
        }

        Text {
            text: "Error";
            font-size: Theme.font_caption;
            font-weight: 700;
            color: white;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component AppBar inherits Rectangle {
    in property <string> status_text;
    in property <color> status_color;
    in property <bool> mic_enabled;
    in property <bool> has_error;

    callback open_url(string);
    callback help_clicked();
    callback error_chip_clicked();

    height: 52px;
    background: Theme.panel;

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 16px;

        Text {
            text: "SPECTRAL";
            font-size: Theme.font_brand;
            font-weight: 700;
            letter-spacing: 2px;
            color: white;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;

            StatusPill {
                label: root.status_text;
                pill_color: root.status_color;
                enabled_look: root.mic_enabled;
            }
        }

        if root.has_error: VerticalLayout {
            alignment: center;

            ErrorChip {
                clicked => {
                    root.error_chip_clicked();
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        ClickableLink {
            text: "Source Code";
            font_size: Theme.font_caption;
            clicked => {
                root.open_url("https://codeberg.org/mmc/spectral");
            }
        }

        ClickableLink {
            text: "License";
            font_size: Theme.font_caption;
            clicked => {
                root.open_url("https://codeberg.org/mmc/spectral/src/commit/HEAD/LICENSE");
            }
        }

        ClickableLink {
            text: "Help";
            font_size: Theme.font_caption;
            clicked => {
                root.help_clicked();
            }
        }
    }
}
