// Modal overlay walking through why a microphone may be missing from the
// device list.

import { Theme } from "theme.slint";
import { ModalPopup } from "modal-popup.slint";

export component DeviceHelpPopup inherits ModalPopup {
    title: "Device Troubleshooting";

    VerticalLayout {
        // Cards size to their wrapped text (no fixed heights: font
        // metrics follow the user's monospace family); start keeps
        // surplus vertical space below them instead of inflating
        // each card equally.
        alignment: start;
        spacing: 20px;
        padding: 10px;

        // Intro text
        Text {
            text: "If your microphone isn't appearing in the device list, here are some common causes and solutions:";
            font-size: 14px;
            color: Theme.text_muted;
            wrap: word-wrap;
            horizontal-alignment: left;
        }

        // Scenario 1: PipeWire or WirePlumber not running
        Rectangle {
            background: Theme.inset;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 15px;
                spacing: 8px;

                Text {
                    text: "1. PipeWire or WirePlumber Not Running";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.accent;
                }

                Text {
                    text: "Spectral needs PipeWire and its session manager. Check both: `systemctl --user status pipewire wireplumber`";
                    font-size: 13px;
                    color: Theme.text_primary;
                    wrap: word-wrap;
                }
            }
        }

        // Scenario 2: Device not connected
        Rectangle {
            background: Theme.inset;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 15px;
                spacing: 8px;

                Text {
                    text: "2. Device Not Connected or Powered Off";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.accent;
                }

                Text {
                    text: "Check the cable, pairing, and power, then run `wpctl status` — if the device isn't listed under Sources there, PipeWire can't see it.";
                    font-size: 13px;
                    color: Theme.text_primary;
                    wrap: word-wrap;
                }
            }
        }

        // Scenario 3: Bluetooth headset in the wrong profile
        Rectangle {
            background: Theme.inset;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 15px;
                spacing: 8px;

                Text {
                    text: "3. Bluetooth Headset in the Wrong Profile";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.accent;
                }

                Text {
                    text: "Bluetooth mics only capture in the HSP/HFP headset profile; A2DP is playback-only. Switch the profile in your sound settings or `pavucontrol`.";
                    font-size: 13px;
                    color: Theme.text_primary;
                    wrap: word-wrap;
                }
            }
        }

        // Scenario 4: Device disabled or muted
        Rectangle {
            background: Theme.inset;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 15px;
                spacing: 8px;

                Text {
                    text: "4. Device Disabled or Muted";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.accent;
                }

                Text {
                    text: "Check your system's sound settings or `pavucontrol`: the device may be muted, disabled, or its profile set to Off.";
                    font-size: 13px;
                    color: Theme.text_primary;
                    wrap: word-wrap;
                }
            }
        }

        // Scenario 5: Stale devices after a PipeWire restart
        Rectangle {
            background: Theme.inset;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 15px;
                spacing: 8px;

                Text {
                    text: "5. Stale Devices After a PipeWire Restart";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.accent;
                }

                Text {
                    text: "After a PipeWire restart the list may point at devices that no longer exist. Click Refresh and re-select your device before enabling.";
                    font-size: 13px;
                    color: Theme.text_primary;
                    wrap: word-wrap;
                }
            }
        }

        // Tip at the bottom
        Rectangle {
            background: Theme.inset;
            border-color: Theme.accent_bright;
            border-width: 1px;
            border-radius: 6px;

            HorizontalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "Tip: After addressing any of these issues, click the Refresh button to rescan for devices.";
                    font-size: 13px;
                    font-italic: true;
                    color: Theme.accent_bright;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
        }
    }
}
