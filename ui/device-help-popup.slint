// Modal overlay walking through why a microphone may be missing from the
// device list.

import { Theme } from "theme.slint";
import { ModalPopup } from "modal-popup.slint";

export component DeviceHelpPopup inherits ModalPopup {
    title: "Device Troubleshooting";

    VerticalLayout {
        // Cards size to their own wrapped text, which follows the modal's
        // width; start keeps surplus vertical space below them instead of
        // inflating each card equally.
        alignment: start;
        spacing: 20px;
        padding: 10px;

        Text {
            text: "If your microphone isn't appearing in the device list, here are some common causes and solutions:";
            font-size: Theme.font_emphasis;
            color: Theme.text_muted;
            wrap: word-wrap;
            horizontal-alignment: left;
        }

        Rectangle {
            background: Theme.inset;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 15px;
                spacing: 8px;

                Text {
                    text: "1. PipeWire or WirePlumber Not Running";
                    font-size: Theme.font_title;
                    font-weight: 700;
                    color: Theme.accent;
                }

                Text {
                    text: "Spectral needs PipeWire and its session manager. Check both: `systemctl --user status pipewire wireplumber`";
                    font-size: Theme.font_body;
                    color: Theme.text_primary;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            background: Theme.inset;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 15px;
                spacing: 8px;

                Text {
                    text: "2. Device Not Connected or Powered Off";
                    font-size: Theme.font_title;
                    font-weight: 700;
                    color: Theme.accent;
                }

                Text {
                    text: "Check the cable, pairing, and power, then run `wpctl status` — if the device isn't listed under Sources there, PipeWire can't see it.";
                    font-size: Theme.font_body;
                    color: Theme.text_primary;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            background: Theme.inset;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 15px;
                spacing: 8px;

                Text {
                    text: "3. Bluetooth Headset in the Wrong Profile";
                    font-size: Theme.font_title;
                    font-weight: 700;
                    color: Theme.accent;
                }

                Text {
                    text: "Bluetooth mics only capture in the HSP/HFP headset profile; A2DP is playback-only. Switch the profile in your sound settings or `pavucontrol`.";
                    font-size: Theme.font_body;
                    color: Theme.text_primary;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            background: Theme.inset;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 15px;
                spacing: 8px;

                Text {
                    text: "4. Device Disabled or Muted";
                    font-size: Theme.font_title;
                    font-weight: 700;
                    color: Theme.accent;
                }

                Text {
                    text: "Check your system's sound settings or `pavucontrol`: the device may be muted, disabled, or its profile set to Off.";
                    font-size: Theme.font_body;
                    color: Theme.text_primary;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            background: Theme.inset;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 15px;
                spacing: 8px;

                Text {
                    text: "5. The List Is Stale After a PipeWire Restart";
                    font-size: Theme.font_title;
                    font-weight: 700;
                    color: Theme.accent;
                }

                Text {
                    text: "After a PipeWire restart the list may show devices that no longer exist. Enabling your remembered device still works; click Refresh if you want to pick a different one.";
                    font-size: Theme.font_body;
                    color: Theme.text_primary;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            background: Theme.inset;
            border-color: Theme.accent_bright;
            border-width: 1px;
            border-radius: 6px;

            HorizontalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "Tip: After addressing any of these issues, click the Refresh button to rescan for devices.";
                    font-size: Theme.font_body;
                    font-italic: true;
                    color: Theme.accent_bright;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
        }
    }
}
