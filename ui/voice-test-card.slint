// Card for recording a capped voice sample and A/B-ing the original
// against the filtered result. The record button and the status box have
// fixed geometry: every state renders inside the same two containers, so
// the record -> playback -> idle flow causes zero layout shift.

import { AppButton } from "controls.slint";
import { Theme } from "theme.slint";
import { ClickableLink } from "links.slint";

export component VoiceTestCard inherits Rectangle {
    in property <bool> mic_enabled;
    in-out property <bool> is_recording;
    in-out property <bool> has_recording;
    in-out property <bool> is_playing_original;
    in-out property <bool> is_playing_filtered;
    in-out property <int> recording_countdown;

    callback start_recording();
    callback stop_recording();
    callback play_original();
    callback stop_original();
    callback play_filtered();
    callback stop_filtered();

    property <string> elapsed: "0:" + (root.recording_countdown < 10 ? "0" : "") + root.recording_countdown;

    background: Theme.panel;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 6px;

    Timer {
        interval: 1s;
        running: root.is_recording;
        triggered => {
            if (root.recording_countdown < 15) {
                root.recording_countdown = root.recording_countdown + 1;
            } else {
                root.is_recording = false;
                root.has_recording = true;
                root.stop_recording();
            }
        }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: "Record A Voice Test";
                font-size: 13px;
                font-weight: 700;
                color: white;
            }

            Text {
                text: "0:15 max";
                font-size: 10px;
                color: Theme.text_muted;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }
        }

        HorizontalLayout {
            spacing: 10px;

            AppButton {
                width: 100px;
                height: 58px;
                text: root.is_recording ? "■ Stop" : "● Record";
                enabled: root.mic_enabled;
                clicked => {
                    if (root.is_playing_original) {
                        root.is_playing_original = false;
                        root.stop_original();
                    }
                    if (root.is_playing_filtered) {
                        root.is_playing_filtered = false;
                        root.stop_filtered();
                    }
                    root.is_recording = !root.is_recording;

                    if (root.is_recording) {
                        root.recording_countdown = 0;
                        root.has_recording = false;
                        root.start_recording();
                    } else {
                        root.has_recording = true;
                        root.stop_recording();
                    }
                }
            }

            // Always present; only its content and border color follow the
            // state, so nothing around it ever moves.
            Rectangle {
                horizontal-stretch: 1;
                height: 58px;
                background: Theme.inset;
                border-color: root.is_recording ? Theme.error : Theme.border_subtle;
                border-width: 1px;
                border-radius: 5px;
                clip: true;

                if root.is_recording: VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 8px;
                    padding-bottom: 10px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;

                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: Theme.error;
                            }
                        }

                        Text {
                            text: "Recording…";
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.error;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Text {
                            text: root.elapsed + " / 0:15";
                            font-size: 10.5px;
                            color: Theme.text_muted;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.border;

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            height: parent.height;
                            width: parent.width * root.recording_countdown / 15;
                            border-radius: 2px;
                            background: Theme.error;
                        }
                    }
                }

                if !root.is_recording && root.has_recording: VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 4px;
                    alignment: center;

                    // Original output row
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        // Play/Stop button for original
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            background: root.is_playing_original ? Theme.error : Theme.accent;
                            border-radius: 3px;

                            Text {
                                width: 100%;
                                height: 100%;
                                text: root.is_playing_original ? "■" : "▶";
                                font-size: 12px;
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    if (root.is_playing_original) {
                                        root.is_playing_original = false;
                                        root.stop_original();
                                    } else {
                                        // Stop filtered if playing
                                        if (root.is_playing_filtered) {
                                            root.is_playing_filtered = false;
                                            root.stop_filtered();
                                        }
                                        root.is_playing_original = true;
                                        root.play_original();
                                    }
                                }
                            }
                        }

                        ClickableLink {
                            text: "original_output.wav";
                            font_size: 11.5px;
                            clicked => {
                                if (root.is_playing_original) {
                                    root.is_playing_original = false;
                                    root.stop_original();
                                } else {
                                    if (root.is_playing_filtered) {
                                        root.is_playing_filtered = false;
                                        root.stop_filtered();
                                    }
                                    root.is_playing_original = true;
                                    root.play_original();
                                }
                            }
                        }
                    }

                    // Filtered output row
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        // Play/Stop button for filtered
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            background: root.is_playing_filtered ? Theme.error : Theme.accent;
                            border-radius: 3px;

                            Text {
                                width: 100%;
                                height: 100%;
                                text: root.is_playing_filtered ? "■" : "▶";
                                font-size: 12px;
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    if (root.is_playing_filtered) {
                                        root.is_playing_filtered = false;
                                        root.stop_filtered();
                                    } else {
                                        if (root.is_playing_original) {
                                            root.is_playing_original = false;
                                            root.stop_original();
                                        }
                                        root.is_playing_filtered = true;
                                        root.play_filtered();
                                    }
                                }
                            }
                        }

                        ClickableLink {
                            text: "filtered_output.wav";
                            font_size: 11.5px;
                            clicked => {
                                if (root.is_playing_filtered) {
                                    root.is_playing_filtered = false;
                                    root.stop_filtered();
                                } else {
                                    if (root.is_playing_original) {
                                        root.is_playing_original = false;
                                        root.stop_original();
                                    }
                                    root.is_playing_filtered = true;
                                    root.play_filtered();
                                }
                            }
                        }
                    }
                }

                if !root.is_recording && !root.has_recording: Text {
                    width: 100%;
                    height: 100%;
                    text: root.mic_enabled ? "Press Record to start" : "Enable mic to record";
                    font-size: 11px;
                    color: Theme.text_muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
