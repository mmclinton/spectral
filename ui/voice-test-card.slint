// Card for recording a capped voice sample and A/B-ing the original
// against the filtered result.

import { Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ClickableLink } from "links.slint";

export component VoiceTestCard inherits Rectangle {
    in property <bool> mic_enabled;
    in-out property <bool> is_recording;
    in-out property <bool> has_recording;
    in-out property <bool> is_playing_original;
    in-out property <bool> is_playing_filtered;
    in-out property <int> recording_countdown;

    callback start_recording();
    callback stop_recording();
    callback play_original();
    callback stop_original();
    callback play_filtered();
    callback stop_filtered();

    background: Theme.panel;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 6px;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        Text {
            text: "Record A Voice Test";
            font-size: 13px;
            font-weight: 700;
            color: white;
        }

        HorizontalLayout {
            spacing: 10px;

            Button {
                width: 100px;
                height: 58px;
                text: root.is_recording ? "Stop" : "Record";
                enabled: root.mic_enabled;
                clicked => {
                    if (root.is_playing_original) {
                        root.is_playing_original = false;
                        root.stop_original();
                    }
                    if (root.is_playing_filtered) {
                        root.is_playing_filtered = false;
                        root.stop_filtered();
                    }
                    root.is_recording = !root.is_recording;

                    if (root.is_recording) {
                        root.recording_countdown = 0;
                        root.has_recording = false;
                        root.start_recording();
                    } else {
                        root.has_recording = true;
                        root.stop_recording();
                    }
                }
            }

            // Recording countdown indicator
            if root.is_recording: Rectangle {
                horizontal-stretch: 1;
                height: 58px;
                background: #30363D;
                border-color: #FF4444;
                border-width: 2px;
                border-radius: 4px;

                // Timer
                Timer {
                    interval: 1s;
                    running: root.is_recording;
                    triggered => {
                        if (root.recording_countdown < 15) {
                            root.recording_countdown = root.recording_countdown + 1;
                        } else {
                            root.is_recording = false;
                            root.has_recording = true;
                            root.stop_recording();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;

                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: 20px;
                            background: #FF4444;

                            Text {
                                width: 100%;
                                height: 100%;
                                text: root.recording_countdown;
                                font-size: 18px;
                                font-weight: 700;
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "Recording...";
                            font-size: 16px;
                            font-weight: 700;
                            color: #FF4444;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Playback options
            if !root.is_recording && root.has_recording: Rectangle {
                horizontal-stretch: 1;
                height: 58px;
                background: #30363D;
                border-color: #30363D;
                border-width: 1px;
                border-radius: 4px;

                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 4px;
                    alignment: center;

                    // Original output row
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        // Play/Stop button for original
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            background: root.is_playing_original ? #FF4444 : #0085FC;
                            border-radius: 3px;

                            Text {
                                width: 100%;
                                height: 100%;
                                text: root.is_playing_original ? "■" : "▶";
                                font-size: 12px;
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    if (root.is_playing_original) {
                                        root.is_playing_original = false;
                                        root.stop_original();
                                    } else {
                                        // Stop filtered if playing
                                        if (root.is_playing_filtered) {
                                            root.is_playing_filtered = false;
                                            root.stop_filtered();
                                        }
                                        root.is_playing_original = true;
                                        root.play_original();
                                    }
                                }
                            }
                        }

                        ClickableLink {
                            text: "original_output.wav";
                            clicked => {
                                if (root.is_playing_original) {
                                    root.is_playing_original = false;
                                    root.stop_original();
                                } else {
                                    if (root.is_playing_filtered) {
                                        root.is_playing_filtered = false;
                                        root.stop_filtered();
                                    }
                                    root.is_playing_original = true;
                                    root.play_original();
                                }
                            }
                        }
                    }

                    // Filtered output row
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        // Play/Stop button for filtered
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            background: root.is_playing_filtered ? #FF4444 : #0085FC;
                            border-radius: 3px;

                            Text {
                                width: 100%;
                                height: 100%;
                                text: root.is_playing_filtered ? "■" : "▶";
                                font-size: 12px;
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    if (root.is_playing_filtered) {
                                        root.is_playing_filtered = false;
                                        root.stop_filtered();
                                    } else {
                                        if (root.is_playing_original) {
                                            root.is_playing_original = false;
                                            root.stop_original();
                                        }
                                        root.is_playing_filtered = true;
                                        root.play_filtered();
                                    }
                                }
                            }
                        }

                        ClickableLink {
                            text: "filtered_output.wav";
                            clicked => {
                                if (root.is_playing_filtered) {
                                    root.is_playing_filtered = false;
                                    root.stop_filtered();
                                } else {
                                    if (root.is_playing_original) {
                                        root.is_playing_original = false;
                                        root.stop_original();
                                    }
                                    root.is_playing_filtered = true;
                                    root.play_filtered();
                                }
                            }
                        }
                    }
                }
            }

            // Empty placeholder when no recording yet and not recording
            if !root.is_recording && !root.has_recording: Rectangle {
                horizontal-stretch: 1;
                height: 58px;
                background: #30363D;
                border-color: #30363D;
                border-width: 1px;
                border-radius: 4px;

                Text {
                    width: 100%;
                    height: 100%;
                    text: root.mic_enabled ? "Press Record to start" : "Enable mic to record";
                    font-size: 12px;
                    color: #8B949E;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
