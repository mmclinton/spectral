// Card for recording a capped voice sample and A/B-ing the original
// against the filtered result. The record button and the status box have
// fixed geometry: every state renders inside the same two containers, so
// the record -> playback -> idle flow causes zero layout shift.

import { AppButton } from "controls.slint";
import { Theme } from "theme.slint";
import { ClickableLink } from "links.slint";

export component VoiceTestCard inherits Rectangle {
    in property <bool> mic_enabled;
    in-out property <bool> is_recording;
    in-out property <bool> has_recording;
    in-out property <bool> is_playing_original;
    in-out property <bool> is_playing_filtered;
    in-out property <int> recording_countdown;

    callback start_recording();
    callback stop_recording();
    callback play_original();
    callback stop_original();
    callback play_filtered();
    callback stop_filtered();

    property <string> elapsed: "0:" + (root.recording_countdown < 10 ? "0" : "") + root.recording_countdown;

    function stop_playback() {
        if (root.is_playing_original) {
            root.is_playing_original = false;
            root.stop_original();
        }
        if (root.is_playing_filtered) {
            root.is_playing_filtered = false;
            root.stop_filtered();
        }
    }

    function toggle_original() {
        if (root.is_playing_original) {
            root.is_playing_original = false;
            root.stop_original();
        } else {
            root.stop_playback();
            root.is_playing_original = true;
            root.play_original();
        }
    }

    function toggle_filtered() {
        if (root.is_playing_filtered) {
            root.is_playing_filtered = false;
            root.stop_filtered();
        } else {
            root.stop_playback();
            root.is_playing_filtered = true;
            root.play_filtered();
        }
    }

    background: Theme.panel;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 6px;

    Timer {
        interval: 1s;
        running: root.is_recording;
        triggered => {
            root.recording_countdown += 1;
            if (root.recording_countdown >= 15) {
                root.is_recording = false;
                root.has_recording = true;
                root.stop_recording();
            }
        }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: "Record A Voice Test";
                font-size: Theme.font_body;
                font-weight: 700;
                color: white;
            }

            Text {
                text: "0:15 max";
                font-size: Theme.font_caption;
                color: Theme.text_muted;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }
        }

        HorizontalLayout {
            spacing: 10px;

            AppButton {
                width: 100px;
                height: 58px;
                text: root.is_recording ? "■ Stop" : "● Record";
                // Stop must stay reachable even if the mic deactivates
                // mid-recording (daemon death flips mic_enabled false).
                enabled: root.mic_enabled || root.is_recording;
                clicked => {
                    root.stop_playback();
                    root.is_recording = !root.is_recording;

                    if (root.is_recording) {
                        root.recording_countdown = 0;
                        root.has_recording = false;
                        root.start_recording();
                    } else {
                        root.has_recording = true;
                        root.stop_recording();
                    }
                }
            }

            // Always present; only its content and border color follow the
            // state, so nothing around it ever moves.
            Rectangle {
                horizontal-stretch: 1;
                height: 58px;
                background: Theme.inset;
                border-color: root.is_recording ? Theme.error : Theme.border_subtle;
                border-width: 1px;
                border-radius: 5px;
                clip: true;

                if root.is_recording: VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 8px;
                    padding-bottom: 10px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;

                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: Theme.error;
                            }
                        }

                        Text {
                            text: "Recording…";
                            font-size: Theme.font_caption;
                            font-weight: 700;
                            color: Theme.error;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Text {
                            text: root.elapsed + " / 0:15";
                            font-size: Theme.font_caption;
                            color: Theme.text_muted;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.border;

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            height: parent.height;
                            width: parent.width * root.recording_countdown / 15;
                            border-radius: 2px;
                            background: Theme.error;
                        }
                    }
                }

                if !root.is_recording && root.has_recording: VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 4px;
                    alignment: center;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            width: 20px;
                            height: 20px;
                            background: root.is_playing_original ? Theme.error : Theme.accent;
                            border-radius: 3px;

                            accessible-role: button;
                            accessible-label: root.is_playing_original
                                ? "Stop original playback" : "Play original recording";
                            accessible-action-default => {
                                root.toggle_original();
                            }

                            Text {
                                width: 100%;
                                height: 100%;
                                text: root.is_playing_original ? "■" : "▶";
                                font-size: 12px;
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    root.toggle_original();
                                }
                            }
                        }

                        ClickableLink {
                            text: "original_output.wav";
                            font_size: Theme.font_caption;
                            clicked => {
                                root.toggle_original();
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            width: 20px;
                            height: 20px;
                            background: root.is_playing_filtered ? Theme.error : Theme.accent;
                            border-radius: 3px;

                            accessible-role: button;
                            accessible-label: root.is_playing_filtered
                                ? "Stop filtered playback" : "Play filtered recording";
                            accessible-action-default => {
                                root.toggle_filtered();
                            }

                            Text {
                                width: 100%;
                                height: 100%;
                                text: root.is_playing_filtered ? "■" : "▶";
                                font-size: 12px;
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    root.toggle_filtered();
                                }
                            }
                        }

                        ClickableLink {
                            text: "filtered_output.wav";
                            font_size: Theme.font_caption;
                            clicked => {
                                root.toggle_filtered();
                            }
                        }
                    }
                }

                if !root.is_recording && !root.has_recording: Text {
                    width: 100%;
                    height: 100%;
                    text: root.mic_enabled ? "Press Record to start" : "Enable mic to record";
                    font-size: Theme.font_caption;
                    color: Theme.text_muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
