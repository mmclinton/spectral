// Card listing the capture devices the daemon can pipe into the virtual mic.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ClickableLink } from "links.slint";
import { AppButton } from "controls.slint";

export struct InputDevice {
    name: string,
    // Stays empty until per-device props are proven reliable; the row hides
    // an empty meta line rather than showing a placeholder.
    meta: string,
}

component DeviceRow inherits Rectangle {
    in property <InputDevice> device;
    in property <bool> selected;

    callback clicked();

    height: 52px;

    accessible-role: list-item;
    accessible-label: root.device.name;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Rectangle {
        x: 6px;
        y: 2px;
        width: parent.width - 12px;
        height: parent.height - 6px;
        background: root.selected || touch.has-hover ? Theme.inset : transparent;
        border-color: root.selected ? Theme.accent : Theme.border_subtle;
        border-width: 1px;
        border-radius: 5px;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;

            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 3px;
                    height: 28px;
                    border-radius: 1.5px;
                    background: root.selected ? Theme.accent : Theme.border;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.device.name;
                    font-size: 12.5px;
                    font-weight: root.selected ? 500 : 400;
                    color: root.selected ? white : Theme.text_primary;
                    overflow: elide;
                }

                if root.device.meta != "": Text {
                    text: root.device.meta;
                    font-size: 10px;
                    color: Theme.text_muted;
                    overflow: elide;
                }
            }
        }
    }
}

export component SourcePanel inherits Rectangle {
    in property <[InputDevice]> devices;
    in-out property <int> current_index;

    callback selection_changed(int);
    callback refresh_clicked();
    callback device_help_clicked();

    background: Theme.panel;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 6px;
    clip: true;

    // Purely an acknowledgment that the click registered: the rescan is
    // synchronous and near-instant, so the glyph spins for a fixed ~640ms
    // instead of tracking progress. Rotation transforms don't render on
    // the software renderer, hence frame-swapping instead of rotating.
    property <int> spin_ticks: 0;
    property <[string]> spin_frames: ["◓", "◑", "◒", "◐"];

    function start_refresh() {
        root.spin_ticks = 8;
        root.refresh_clicked();
    }

    Timer {
        interval: 80ms;
        running: root.spin_ticks > 0;
        triggered => {
            root.spin_ticks -= 1;
        }
    }

    VerticalLayout {
        Rectangle {
            height: 40px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;

                Text {
                    text: "Original Input Source";
                    font-size: 13px;
                    font-weight: 700;
                    color: white;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Rectangle {
                    width: refresh_row.preferred-width;

                    accessible-role: button;
                    accessible-label: "Refresh device list";
                    accessible-action-default => {
                        root.start_refresh();
                    }

                    refresh_row := HorizontalLayout {
                        spacing: 4px;

                        // Fixed width: the spinner frames are wider than
                        // the idle glyph, and the label must not shift.
                        Text {
                            width: 12px;
                            text: root.spin_ticks > 0
                                ? root.spin_frames[Math.mod(8 - root.spin_ticks, 4)]
                                : "↻";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "Refresh";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.start_refresh();
                        }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.border;
            }
        }

        Rectangle {
            vertical-stretch: 1;

            if root.devices.length > 0: ListView {
                width: 100%;
                height: 100%;

                for device[i] in root.devices: DeviceRow {
                    device: device;
                    selected: i == root.current_index;
                    clicked => {
                        root.current_index = i;
                        root.selection_changed(i);
                    }
                }
            }

            if root.devices.length == 0: Rectangle {
                x: 12px;
                y: 8px;
                width: parent.width - 24px;
                height: parent.height - 16px;
                border-color: Theme.border_subtle;
                border-width: 1px;
                border-radius: 5px;

                VerticalLayout {
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: "⌀";
                        font-size: 22px;
                        color: Theme.text_disabled;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "No input devices found";
                        font-size: 11.5px;
                        color: Theme.text_muted;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;

                        AppButton {
                            text: "↻ Retry scan";
                            clicked => {
                                root.start_refresh();
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            padding: 10px;
            alignment: end;

            ClickableLink {
                text: "Not seeing your device?";
                font_size: 10px;
                italic: true;
                clicked => {
                    root.device_help_clicked();
                }
            }
        }
    }
}
