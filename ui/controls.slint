// Hand-rolled controls sharing the app accent. std-widgets exposes every
// Palette brush as `out` and the fluent widgets hardcode their own colors,
// so owning these controls is the only way their accent can match the rest
// of the theme.

import { Theme } from "theme.slint";

export component AppButton {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;

    callback clicked();

    min-width: max(32px, label.preferred-width + 24px);
    min-height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: focus_scope;

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    focus_scope := FocusScope {
        enabled: root.enabled;

        key-pressed(event) => {
            // FocusScope's own `enabled` does not stop key delivery to a
            // scope that already has focus, so a button disabled while it
            // holds focus would still fire.
            if (root.enabled && (event.text == " " || event.text == Key.Return)) {
                root.clicked();
                return accept;
            }
            reject
        }

        Rectangle {
            border-radius: 4px;
            border-width: 1px;
            background: !root.enabled ? Theme.border_subtle
                : touch.pressed ? (root.primary ? Theme.accent.darker(0.2) : Theme.inset)
                : touch.has-hover ? (root.primary ? Theme.accent.brighter(0.15) : Theme.border_subtle.brighter(0.6))
                : (root.primary ? Theme.accent : Theme.border_subtle);
            border-color: focus_scope.has-focus ? Theme.accent_bright
                : !root.enabled ? Theme.border_subtle
                : root.primary ? transparent
                : Theme.border;

            label := Text {
                text: root.text;
                font-size: Theme.font_body;
                font-weight: 600;
                color: !root.enabled ? Theme.text_disabled
                    : root.primary ? white
                    : Theme.text_primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            touch := TouchArea {
                enabled: root.enabled;
                clicked => {
                    focus_scope.focus();
                    root.clicked();
                }
            }
        }
    }
}

export component AppSwitch {
    in property <string> label;
    in property <bool> enabled: true;
    in-out property <bool> checked;

    callback toggled();

    width: 40px;
    height: 20px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: focus_scope;

    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.toggle();
    }

    function toggle() {
        if (root.enabled) {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    focus_scope := FocusScope {
        enabled: root.enabled;

        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.toggle();
                return accept;
            }
            reject
        }

        rail := Rectangle {
            border-radius: self.height / 2;
            border-width: 2px;
            background: !root.enabled ? Theme.border_subtle
                : root.checked ? (touch.has-hover ? Theme.accent.brighter(0.15) : Theme.accent)
                : (touch.has-hover ? Theme.border_subtle.brighter(0.6) : Theme.inset);
            border-color: focus_scope.has-focus ? Theme.accent_bright
                : root.checked || !root.enabled ? transparent
                : Theme.border;

            thumb := Rectangle {
                width: 14px;
                height: 14px;
                y: (parent.height - self.height) / 2;
                x: root.checked ? parent.width - self.width - 3px : 3px;
                border-radius: self.width / 2;
                background: !root.enabled ? Theme.text_disabled
                    : root.checked ? white
                    : Theme.text_muted;
                animate x { duration: 150ms; easing: ease-in-out; }
            }

            touch := TouchArea {
                enabled: root.enabled;
                clicked => {
                    focus_scope.focus();
                    root.toggle();
                }
            }
        }
    }
}

// Integer-valued: the app's only slider is the 0-100 threshold, and int
// keeps `value <=>` type-compatible with the staged threshold, so external
// updates keep flowing after the user drags (no binding to destroy).
// The track spans the full component width - the fluent slider inset it by
// half a thumb, misaligning it with text sharing the same margin - so the
// thumb overhangs the box by up to 7px at the extremes; parents must not clip.
export component AppSlider {
    in property <string> label;
    in property <bool> enabled: true;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in-out property <int> value;

    callback changed(int);

    min-height: 20px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    forward-focus: focus_scope;

    accessible-role: slider;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-value: "\{root.value}";
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: 1;
    accessible-action-increment => {
        root.set_value(root.value + 1);
    }
    accessible-action-decrement => {
        root.set_value(root.value - 1);
    }

    property <float> fraction: root.maximum > root.minimum
        ? (root.value - root.minimum) * 1.0 / (root.maximum - root.minimum)
        : 0;

    function set_value(new_value: int) {
        if (!root.enabled) {
            return;
        }
        if (Math.clamp(new_value, root.minimum, root.maximum) != root.value) {
            root.value = Math.clamp(new_value, root.minimum, root.maximum);
            root.changed(root.value);
        }
    }

    function set_from_position(position: length) {
        root.set_value(root.minimum + Math.round(
            (root.maximum - root.minimum) * Math.clamp(position / track.width, 0, 1)));
    }

    focus_scope := FocusScope {
        enabled: root.enabled;

        key-pressed(event) => {
            if (event.text == Key.LeftArrow) {
                root.set_value(root.value - 1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.set_value(root.value + 1);
                return accept;
            }
            reject
        }

        track := Rectangle {
            y: (parent.height - self.height) / 2;
            width: parent.width;
            height: 4px;
            border-radius: 2px;
            background: Theme.border;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * root.fraction;
                height: parent.height;
                border-radius: 2px;
                background: Theme.accent;
            }
        }

        thumb := Rectangle {
            x: track.width * root.fraction - self.width / 2;
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            border-radius: self.width / 2;
            background: touch.pressed ? Theme.accent_bright : white;
            border-width: focus_scope.has-focus ? 2px : 0px;
            border-color: Theme.accent_bright;
        }

        touch := TouchArea {
            enabled: root.enabled;
            moved => {
                root.set_from_position(self.mouse-x);
            }
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    focus_scope.focus();
                    root.set_from_position(self.mouse-x);
                }
            }
        }
    }
}
