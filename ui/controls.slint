// Hand-rolled controls sharing the app accent. Slint 1.15's std-widgets
// Palette is read-only and the fluent widgets hardcode their own colors
// (slint-ui/slint#9568 landed only after 1.15), so owning these controls
// is the only way their accent can match the rest of the theme.

import { Theme } from "theme.slint";

export component AppButton {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;

    callback clicked();

    min-width: max(32px, label.preferred-width + 24px);
    min-height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: focus_scope;

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.clicked();
    }

    focus_scope := FocusScope {
        enabled: root.enabled;

        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }

        Rectangle {
            border-radius: 4px;
            border-width: 1px;
            background: !root.enabled ? Theme.border_subtle
                : touch.pressed ? (root.primary ? Theme.accent.darker(0.2) : Theme.inset)
                : touch.has-hover ? (root.primary ? Theme.accent.brighter(0.15) : Theme.border_subtle.brighter(0.6))
                : (root.primary ? Theme.accent : Theme.border_subtle);
            border-color: focus_scope.has-focus ? Theme.accent_bright
                : !root.enabled ? Theme.border_subtle
                : root.primary ? transparent
                : Theme.border;

            label := Text {
                text: root.text;
                font-size: 13px;
                font-weight: 600;
                color: !root.enabled ? Theme.text_disabled
                    : root.primary ? white
                    : Theme.text_primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            touch := TouchArea {
                enabled: root.enabled;
                clicked => {
                    focus_scope.focus();
                    root.clicked();
                }
            }
        }
    }
}

export component AppSwitch {
    in property <bool> enabled: true;
    in-out property <bool> checked;

    callback toggled();

    width: 40px;
    height: 20px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: focus_scope;

    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.toggle();
    }

    function toggle() {
        if (root.enabled) {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    focus_scope := FocusScope {
        enabled: root.enabled;

        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.toggle();
                return accept;
            }
            reject
        }

        rail := Rectangle {
            border-radius: self.height / 2;
            border-width: 1px;
            background: !root.enabled ? Theme.border_subtle
                : root.checked ? (touch.has-hover ? Theme.accent.brighter(0.15) : Theme.accent)
                : (touch.has-hover ? Theme.border_subtle.brighter(0.6) : Theme.inset);
            border-color: focus_scope.has-focus ? Theme.accent_bright
                : root.checked || !root.enabled ? transparent
                : Theme.border;

            thumb := Rectangle {
                width: 14px;
                height: 14px;
                y: (parent.height - self.height) / 2;
                x: root.checked ? parent.width - self.width - 3px : 3px;
                border-radius: self.width / 2;
                background: !root.enabled ? Theme.text_disabled
                    : root.checked ? white
                    : Theme.text_muted;
                animate x { duration: 150ms; easing: ease-in-out; }
            }

            touch := TouchArea {
                enabled: root.enabled;
                clicked => {
                    focus_scope.focus();
                    root.toggle();
                }
            }
        }
    }
}
