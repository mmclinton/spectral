// Shared modal chrome: dimmed click-to-close overlay, centered panel,
// titled header with a close button, and a scrollable region that hosts the
// caller's content layout. Fills the window; sized relative to it so it
// tracks resizes.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component ModalPopup inherits Rectangle {
    in property <string> title;

    callback close_clicked();

    background: #0D111799; // Semi-transparent dark overlay

    // Block clicks from passing through
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.close_clicked();
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 90%;
        height: 90%;
        background: Theme.panel;
        border-color: Theme.border;
        border-width: 2px;
        border-radius: 8px;

        // Prevent clicks inside the popup from closing it
        TouchArea {
            width: 100%;
            height: 100%;
        }

        // Popup header
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 36px;

            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.border;
            }

            Text {
                width: 100%;
                height: 100%;
                text: root.title;
                font-size: 16px;
                font-weight: 700;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Close button
            Rectangle {
                x: parent.width - 32px;
                y: 4px;
                width: 28px;
                height: 28px;
                background: #FF444488;
                border-radius: 4px;

                Text {
                    width: 100%;
                    height: 100%;
                    text: "✕";
                    font-size: 14px;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.close_clicked();
                    }
                }
            }
        }

        // Scrollable content area
        ScrollView {
            x: 20px;
            y: 50px;
            width: parent.width - 40px;
            height: parent.height - 70px;

            @children
        }
    }
}
