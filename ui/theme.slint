// Shared design tokens for the control panel (GitHub-dark family).
// Widgets read colors from here rather than repeating hex literals.

export global Theme {
    out property <color> bg: #0D1117;
    out property <color> panel: #161B22;
    out property <color> inset: #0D1117;
    out property <color> border: #30363D;
    out property <color> border_subtle: #21262D;
    out property <color> accent: #0085FC;
    out property <color> accent_bright: #58A6FF;
    out property <color> text_primary: #C9D1D9;
    out property <color> text_muted: #8B949E;
    out property <color> text_disabled: #484F58;
    out property <color> ok: #2EA043;
    out property <color> warn: #D29922;
    out property <color> warn_bg: #D299221A;
    out property <color> warn_border: #D2992245;
    out property <color> error: #FF4444;

    // Type scale. 12px is a floor, not a preference: the software renderer
    // rasterizes glyphs unhinted into a grayscale alpha map, which loses stem
    // definition fastest below ~12px, and it truncates a requested size to
    // whole physical pixels — so the 10.5/11.5/12.5px steps this replaced
    // never rendered distinctly from 10/11/12px in the first place.
    // Glyphs used as icons (▶ ■ ✕ ⌀) size to their box and stay literal.
    out property <length> font_caption: 12px;
    out property <length> font_body: 13px;
    out property <length> font_emphasis: 14px;
    out property <length> font_brand: 15px;
    out property <length> font_title: 16px;
    out property <length> font_display: 18px;
}
