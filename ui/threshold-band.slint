// Full-width band for the app's main tuning control. It looks the same in
// every state: the threshold is editable before the mic comes up, so dimming
// it would mislabel a live control as inert.

import { AppSlider } from "controls.slint";
import { Theme } from "theme.slint";

export component ThresholdBand inherits Rectangle {
    in-out property <int> value;

    callback threshold_changed(int);

    // Fixed so the band never reflows. 84px against 79px of
    // content (10 + 21 heading + 2 + 20 slider + 2 + 14 anchors + 10) - the
    // remainder is the slider's own breathing room.
    height: 84px;
    background: Theme.bg;

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border_subtle;
    }

    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 2px;

        HorizontalLayout {
            spacing: 10px;

            Text {
                text: "Input Threshold";
                font-size: Theme.font_emphasis;
                font-weight: 700;
                color: white;
                vertical-alignment: center;
            }

            Text {
                text: "gate opens on voice confidence above threshold";
                font-size: Theme.font_caption;
                color: Theme.text_muted;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: "\{root.value}%";
                font-size: Theme.font_display;
                font-weight: 700;
                color: Theme.accent_bright;
                vertical-alignment: center;
            }
        }

        AppSlider {
            label: "Input Threshold";
            value <=> root.value;
            minimum: 0;
            maximum: 100;
            changed(value) => {
                // Don't auto-apply - the GUI recomputes its unsaved-changes chips
                root.threshold_changed(value);
            }
        }

        // The endpoint anchors stay flush with the track ends. The labels
        // bind x, which keeps them out of the width-constraint aggregation
        // - width-bound layout children report their width as both minimum
        // and maximum, locking the window to its launch width.
        Rectangle {
            height: anchor_left.preferred-height;

            anchor_left := Text {
                x: 0px;
                y: 0px;
                width: parent.width / 2;
                text: "0% · denoise only";
                font-size: Theme.font_caption;
                color: Theme.text_muted;
                horizontal-alignment: left;
            }

            Text {
                x: parent.width / 2;
                y: 0px;
                width: parent.width / 2;
                text: "100% · strict";
                font-size: Theme.font_caption;
                color: Theme.text_muted;
                horizontal-alignment: right;
            }
        }
    }
}
