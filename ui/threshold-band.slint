// Full-width band for the app's main tuning control. The caption and scale
// anchors render in every state — only opacity communicates inactive — so
// the control's meaning never disappears with state.

import { AppSlider } from "controls.slint";
import { Theme } from "theme.slint";

export component ThresholdBand inherits Rectangle {
    in-out property <int> value;
    in property <bool> mic_enabled;

    callback threshold_changed(int);

    height: 96px;
    background: Theme.bg;

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border_subtle;
    }

    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 14px;
        padding-bottom: 12px;
        spacing: 2px;

        HorizontalLayout {
            spacing: 10px;
            opacity: root.mic_enabled ? 1 : 0.55;

            Text {
                text: "Input Threshold";
                font-size: Theme.font_emphasis;
                font-weight: 700;
                color: white;
                vertical-alignment: center;
            }

            Text {
                text: "gate opens on voice confidence above threshold";
                font-size: Theme.font_caption;
                color: Theme.text_muted;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: "\{root.value}%";
                font-size: Theme.font_display;
                font-weight: 700;
                color: root.mic_enabled ? Theme.accent_bright : Theme.text_muted;
                vertical-alignment: center;
            }
        }

        AppSlider {
            label: "Input Threshold";
            opacity: root.mic_enabled ? 1 : 0.55;
            value <=> root.value;
            minimum: 0;
            maximum: 100;
            changed(value) => {
                // Don't auto-apply - the GUI recomputes its local pending status
                root.threshold_changed(value);
            }
        }

        // The endpoint anchors stay flush with the track ends. The labels
        // bind x, which keeps them out of the width-constraint aggregation
        // - width-bound layout children report their width as both minimum
        // and maximum, locking the window to its launch width.
        Rectangle {
            height: anchor_left.preferred-height;

            anchor_left := Text {
                x: 0px;
                y: 0px;
                width: parent.width / 2;
                text: "0% · denoise only";
                font-size: Theme.font_caption;
                color: Theme.text_muted;
                horizontal-alignment: left;
            }

            Text {
                x: parent.width / 2;
                y: 0px;
                width: parent.width / 2;
                text: "100% · strict";
                font-size: Theme.font_caption;
                color: Theme.text_muted;
                horizontal-alignment: right;
            }
        }
    }
}
