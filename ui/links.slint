export component ClickableLink {
    in property <string> text;
    callback clicked();

    link-text := Text {
        text: root.text;
        font-size: 14px;
        font-weight: 700;
        color: #0085FC;
        horizontal-alignment: left;
        vertical-alignment: center;
    }

    TouchArea {
        x: link-text.x;
        y: link-text.y;
        width: link-text.preferred-width;
        height: link-text.preferred-height;
        clicked => { root.clicked(); }
    }
}