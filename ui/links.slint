export component ClickableLink {
    in property <string> text;
    callback clicked();

    Text {
        width: 100%; 
        height: 100%;
        text: root.text;
        font-size: 14px;
        font-weight: 700;
        color: #0085FC;
        horizontal-alignment: left;
        vertical-alignment: center;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}