import { Theme } from "theme.slint";

export component ClickableLink {
    in property <string> text;
    in property <length> font_size: 14px;
    in property <bool> italic: false;
    callback clicked();

    // Width hugs the label so the link never absorbs layout slack; height
    // still fills the layout cell so the text stays vertically centered.
    width: link-text.preferred-width;

    link-text := Text {
        text: root.text;
        font-size: root.font_size;
        font-italic: root.italic;
        font-weight: 700;
        color: Theme.accent;
        horizontal-alignment: left;
        vertical-alignment: center;
    }

    TouchArea {
        x: link-text.x;
        y: link-text.y;
        width: link-text.preferred-width;
        height: link-text.preferred-height;
        clicked => { root.clicked(); }
    }
}
