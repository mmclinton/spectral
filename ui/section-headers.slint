export component SectionHeader {
    in property <string> title;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 360px;
        height: 30px;
        background: #264F78;
        border-color: #30363D;
        border-width: 1px;
        border-radius: 2px;

        Text {
            width: parent.width;
            height: parent.height;
            text: root.title;
            font-size: 14px;
            font-weight: 700;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}