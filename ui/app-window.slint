import {
    Slider,
    Button,
    LineEdit,
    ListView,
    StandardListView,
} from "std-widgets.slint";
import { SectionHeader } from "section-headers.slint";
import { ClickableLink } from "links.slint";

export component MainWindow inherits Window {
    title: "Spectral";
    // JetBrains Mono is provided via fontconfig wrapper in Nix builds
    default-font-family: "JetBrains Mono";
    min-width: 920px;
    min-height: 800px;
    background: #0D1117;

    property <string> default_mic_name: "Spectral-Mic";
    in-out property <string> mic_name_text: "Spectral-Mic";
    in-out property <int> selected_input_index: -1;
    in-out property <[StandardListViewItem]> input_devices;
    in-out property <int> slider_value: 80;
    in-out property <bool> is_recording: false;
    in-out property <bool> has_recording: false;
    in-out property <bool> is_playing_original: false;
    in-out property <bool> is_playing_filtered: false;
    in-out property <int> recording_countdown: 0;
    in-out property <string> status_text: "Status: Inactive";
    in-out property <color> status_color: #FF0000;

    callback selected_input_index_change(int);
    callback threshold_change(int);
    callback rename_clicked(string);
    callback reset_clicked(string);
    callback enable_clicked();
    callback disable_clicked();
    callback mic_name_text_changed(string);
    callback refresh_devices_clicked();
    callback open_url(string);
    callback start_recording();
    callback stop_recording();
    callback play_original();
    callback stop_original();
    callback play_filtered();
    callback stop_filtered();
    callback poll_playback_status();

    // Timer to poll playback status when playing
    Timer {
        interval: 250ms;
        running: root.is_playing_original || root.is_playing_filtered;
        triggered => {
            root.poll_playback_status();
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;

        Rectangle {
            x: ((parent.width / 2) - (self.width / 2));
            y: 0px;
            width: 920px;
            height: 760px;
            background: #0D1117;

            ClickableLink {
                x: 50px;
                y: 20px;
                text: "Source Code";
                clicked => {
                    root.open_url("https://codeberg.org/mmc/spectral");
                }
            }

            ClickableLink {
                x: 50px;
                y: 40px;
                text: "License";
                clicked => {
                    root.open_url("https://codeberg.org/mmc/spectral/src/commit/HEAD/LICENSE");
                }
            }

            ClickableLink {
                x: 50px;
                y: 60px;
                text: "Help";
                clicked => {
                    debug("Open Help");
                }
            }

            // Status bar
            Rectangle {
                x: ((parent.width / 2) - (self.width / 2));
                y: 20px;
                width: 330px;
                height: 40px;
                background: #161B22;
                border-color: root.status_color;
                border-width: 1px;
                border-radius: 4px;

                Text {
                    width: parent.width;
                    height: 30px;
                    text: root.status_text;
                    font-size: 18px;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Input Threshold label
            Text {
                x: ((parent.width / 2) - (self.width / 2));
                y: 110px;
                width: 175px;
                height: 30px;
                text: "Input Threshold";
                font-size: 16px;
                font-weight: 700;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Slider
            slider := Slider {
                x: ((parent.width / 2) - (self.width / 2));
                y: 140px;
                width: 535px;
                height: 50px;
                value: root.slider_value;
                minimum: 0;
                maximum: 100;
                changed(value) => {
                    root.slider_value = value;
                    // Don't auto-apply - just notify daemon of pending change
                    root.threshold_change(value)
                }
            }

            // Threshold value
            Text {
                x: (((parent.width / 2) - (self.width / 2)) + (slider.width / 2) + (self.width / 2)); //cursed placement
                y: 150px;
                width: 60px;
                height: 30px;
                text: "\{slider_value}%";
                font-size: 18px;
                font-weight: 700;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Left section: Original Input Source
            Rectangle {
                x: 50px;
                y: 210px;
                width: 380px;
                height: 460px;
                background: #161B22;
                border-color: #30363D;
                border-width: 1px;
                border-radius: 4px;

                // Header
                SectionHeader {
                    x: 10px;
                    y: 10px;
                    title: "Original Input Source";
                }

                // List background
                Rectangle {
                    x: 10px;
                    y: 50px;
                    width: 360px;
                    height: 400px;
                    background: #30363D;
                    border-color: #30363D;
                    border-width: 1px;
                    border-radius: 2px;

                    VerticalLayout {
                        padding-top: 15px;
                        padding-bottom: 25px;
                        padding-left: 5px;
                        padding-right: 5px;
                        spacing: 40px;

                        inputs_list := StandardListView {
                            model: root.input_devices;
                            current_item <=> root.selected_input_index;
                            current_item_changed => {
                                root.selected_input_index_change(self.current_item);
                            }
                        }
                    }

                    Rectangle {
                        x: 5px;
                        y: parent.height - 33px;
                        width: 98px;
                        height: 26px;
                        background: #161B22;
                        border-width: 1px;
                        border-radius: 2px;

                        Button {
                            width: 100px;
                            height: 28px;
                            text: "Refresh";
                            clicked => {
                                root.refresh_devices_clicked();
                            }
                        }
                    }

                    // Not seeing your device? 
                    device-help := Text {
                        width: parent.width - 15px;
                        height: parent.height - 15px;
                        text: "Not seeing your device?";
                        font-size: 10px;
                        font-italic: true;
                        color: #0085FC;
                        horizontal-alignment: right;
                        vertical-alignment: bottom;
                    }

                    TouchArea {
                        x: device-help.x + (345px - 140px);
                        y: device-help.y + (385px - 15px);
                        width: device-help.width - (345px - 140px);
                        height: device-help.height - (385px - 15px);
                        clicked => {
                            debug("Open device troubleshooting");
                        }
                    }
                }
            }

            // Right section: Virtual Mic Name
            Rectangle {
                x: 490px;
                y: 210px;
                width: 380px;
                height: 460px;
                background: #161B22;
                border-color: #30363D;
                border-width: 1px;
                border-radius: 4px;

                // Header
                SectionHeader {
                    x: 10px;
                    y: 10px;
                    title: "Virtual Mic Name";
                }

                // Input field with buttons
                Rectangle {
                    x: 10px;
                    y: 50px;
                    width: 360px;
                    height: 30px;
                    background: #30363D;
                    border-color: #30363D;
                    border-width: 1px;
                    border-radius: 5px;

                    mic_name := TextInput {
                        x: 15px;
                        y: 0px;
                        height: 30px;
                        text <=> root.mic_name_text;
                        font-size: 14px;
                        color: white;
                        vertical-alignment: center;
                        edited() => {
                            root.mic_name_text_changed(self.text);
                        }
                    }

                    // Rename button
                    Rectangle {
                        x: 200px;
                        y: 0px;
                        width: 89px;
                        height: 30px;
                        background: #5E5E5E;
                        border-color: #30363D;
                        border-width: 1px;

                        Button {
                            width: parent.width;
                            height: parent.height;
                            text: "Rename";
                            clicked => {
                                mic_name.clear-focus();
                                root.rename_clicked(mic_name.text);
                            }
                        }
                    }

                    // Reset button
                    Rectangle {
                        x: 288px;
                        y: 0px;
                        width: 72px;
                        height: 30px;
                        background: #5E5E5E;
                        border-color: #30363D;
                        border-width: 1px;

                        Button {
                            width: parent.width;
                            height: parent.height;
                            text: "Reset";
                            clicked => {
                                mic_name.clear-focus();
                                if (mic_name.text != root.default_mic_name) {
                                    mic_name.text = root.default_mic_name;
                                    root.reset_clicked(root.default_mic_name);
                                }
                            }
                        }
                    }
                }

                // Voice Test Header
                SectionHeader {
                    x: 10px;
                    y: 350px;
                    title: "Record A Voice Test";
                }

                // Recording Area
                HorizontalLayout {
                    x: 10px;
                    y: 390px;
                    width: 360px;
                    height: 60px;
                    horizontal-stretch: 0;
                    spacing: 10px;

                    // Record button
                    Button {
                        width: 100px;
                        height: 58px;
                        text: root.is_recording ? "Stop" : "Record";
                        enabled: root.status_color != #FF0000;
                        clicked => {
                            if (root.is_playing_original) {
                                root.is_playing_original = false;
                                root.stop_original();
                            }
                            if (root.is_playing_filtered) {
                                root.is_playing_filtered = false;
                                root.stop_filtered();
                            }
                            root.is_recording = !root.is_recording;

                            if (root.is_recording) {
                                root.recording_countdown = 0;
                                root.has_recording = false;
                                root.start_recording();
                            } else {
                                root.has_recording = true;
                                root.stop_recording();
                            }
                        }
                    }

                    // Recording countdown indicator
                    if root.is_recording: Rectangle {
                        width: 240px;
                        height: 58px;
                        background: #30363D;
                        border-color: #FF4444;
                        border-width: 2px;
                        border-radius: 4px;

                        // Timer
                        Timer {
                            interval: 1s;
                            running: root.is_recording;
                            triggered => {
                                if (root.recording_countdown < 15) {
                                    root.recording_countdown = root.recording_countdown + 1;
                                } else {
                                    root.is_recording = false;
                                    root.has_recording = true;
                                    root.stop_recording();
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;

                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: 20px;
                                    background: #FF4444;

                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.recording_countdown;
                                        font-size: 18px;
                                        font-weight: 700;
                                        color: white;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Recording...";
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: #FF4444;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Playback options
                    if !root.is_recording && root.has_recording: Rectangle {
                        width: 240px;
                        height: 58px;
                        background: #30363D;
                        border-color: #30363D;
                        border-width: 1px;
                        border-radius: 4px;

                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 4px;
                            alignment: center;

                            // Original output row
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                // Play/Stop button for original
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    background: root.is_playing_original ? #FF4444 : #0085FC;
                                    border-radius: 3px;

                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.is_playing_original ? "■" : "▶";
                                        font-size: 12px;
                                        color: white;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => {
                                            if (root.is_playing_original) {
                                                root.is_playing_original = false;
                                                root.stop_original();
                                            } else {
                                                // Stop filtered if playing
                                                if (root.is_playing_filtered) {
                                                    root.is_playing_filtered = false;
                                                    root.stop_filtered();
                                                }
                                                root.is_playing_original = true;
                                                root.play_original();
                                            }
                                        }
                                    }
                                }

                                ClickableLink {
                                    text: "original_output.wav";
                                    clicked => {
                                        if (root.is_playing_original) {
                                            root.is_playing_original = false;
                                            root.stop_original();
                                        } else {
                                            if (root.is_playing_filtered) {
                                                root.is_playing_filtered = false;
                                                root.stop_filtered();
                                            }
                                            root.is_playing_original = true;
                                            root.play_original();
                                        }
                                    }
                                }
                            }

                            // Filtered output row
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                // Play/Stop button for filtered
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    background: root.is_playing_filtered ? #FF4444 : #0085FC;
                                    border-radius: 3px;

                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.is_playing_filtered ? "■" : "▶";
                                        font-size: 12px;
                                        color: white;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => {
                                            if (root.is_playing_filtered) {
                                                root.is_playing_filtered = false;
                                                root.stop_filtered();
                                            } else {
                                                if (root.is_playing_original) {
                                                    root.is_playing_original = false;
                                                    root.stop_original();
                                                }
                                                root.is_playing_filtered = true;
                                                root.play_filtered();
                                            }
                                        }
                                    }
                                }

                                ClickableLink {
                                    text: "filtered_output.wav";
                                    clicked => {
                                        if (root.is_playing_filtered) {
                                            root.is_playing_filtered = false;
                                            root.stop_filtered();
                                        } else {
                                            if (root.is_playing_original) {
                                                root.is_playing_original = false;
                                                root.stop_original();
                                            }
                                            root.is_playing_filtered = true;
                                            root.play_filtered();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Empty placeholder when no recording yet and not recording
                    if !root.is_recording && !root.has_recording: Rectangle {
                        width: 240px;
                        height: 58px;
                        background: #30363D;
                        border-color: #30363D;
                        border-width: 1px;
                        border-radius: 4px;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: root.status_color == #FF0000 ? "Enable mic to record" : "Press Record to start";
                            font-size: 12px;
                            color: #8B949E;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Disable button
            Button {
                x: 250px;
                y: 700px;
                width: 140px;
                height: 40px;
                text: "Disable";
                clicked => {
                    if (root.status_color != #FF0000) {
                        apply.text = "Enable";
                        root.disable_clicked();
                    }
                }
            }

            // Apply button
            apply := Button {
                x: 530px;
                y: 700px;
                width: 140px;
                height: 40px;
                text: root.status_color == #FF0000 ? "Enable" : "Apply";
                clicked => {
                    root.enable_clicked();
                }
            }
        }
    }
}
