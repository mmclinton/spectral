import { Theme } from "theme.slint";
import { AppBar } from "app-bar.slint";
import { ThresholdBand } from "threshold-band.slint";
import { SourcePanel, InputDevice } from "source-panel.slint";
import { MicNameCard } from "mic-name-card.slint";
import { ProcessingCard } from "processing-card.slint";
import { VoiceTestCard } from "voice-test-card.slint";
import { Footer } from "footer.slint";
import { DeviceHelpPopup } from "device-help-popup.slint";
import { HelpPopup } from "help-popup.slint";
import { ErrorPopup } from "error-popup.slint";

// Embedded so every install renders the same face; packaging/subset-fonts.sh
// regenerates these from upstream. One file per weight and style used
// below: Slint answers a request it cannot satisfy with the nearest face
// it holds rather than synthesizing one.
import "fonts/IosevkaAile-Regular.ttf";
import "fonts/IosevkaAile-Medium.ttf";
import "fonts/IosevkaAile-SemiBold.ttf";
import "fonts/IosevkaAile-Bold.ttf";
import "fonts/IosevkaAile-Italic.ttf";
import "fonts/IosevkaAile-BoldItalic.ttf";

export { InputDevice }

export component MainWindow inherits Window {
    title: "Spectral";
    default-font-family: "Iosevka Aile";
    // The layout's arithmetic floor is ~676x647 (fixed chrome plus the
    // right-column card minimums); the margin absorbs real font metrics.
    // The preferred size is the launch size; the minimums only floor
    // manual resizing.
    min-width: 720px;
    min-height: 680px;
    preferred-width: 920px;
    preferred-height: 760px;
    background: Theme.bg;

    property <string> default_mic_name: "Spectral-Mic";
    in-out property <string> mic_name_text: "Spectral-Mic";
    in-out property <int> selected_input_index: -1;
    in-out property <[InputDevice]> input_devices;
    in-out property <int> slider_value: 50;
    in-out property <bool> rumble_filter: false;
    in-out property <bool> auto_level: false;
    in-out property <bool> is_recording: false;
    in-out property <bool> has_recording: false;
    in-out property <bool> is_playing_original: false;
    in-out property <bool> is_playing_filtered: false;
    in-out property <int> recording_countdown: 0;
    in-out property <string> status_text: "Inactive";
    in-out property <string> error_text: "";
    in-out property <bool> mic_enabled: false;
    in-out property <bool> reconnecting: false;
    in-out property <bool> show_device_help_popup: false;
    in-out property <bool> show_help_popup: false;
    // Rust opens this one (the chip click has to snapshot fresh diagnostics
    // first); Slint closes it, like the help popups above.
    in-out property <bool> show_error_popup: false;
    in property <string> diagnostics_text;
    in-out property <bool> mic_name_invalid_flash: false;
    in-out property <[string]> unsaved_changes;

    callback selected_input_index_changed(int);
    callback threshold_changed(int);
    callback rumble_filter_changed(bool);
    callback auto_level_changed(bool);
    callback rename_clicked(string);
    callback reset_clicked(string);
    callback enable_clicked();
    callback disable_clicked();
    callback mic_name_text_changed(string);
    callback refresh_devices_clicked();
    callback open_url(string);
    callback start_recording();
    callback stop_recording();
    callback play_original();
    callback stop_original();
    callback play_filtered();
    callback stop_filtered();
    callback poll_daemon_state();
    callback error_chip_clicked();

    // Always-on daemon reconcile: 1s heartbeat, 250ms while playback
    // glyphs need snappy updates
    Timer {
        interval: (root.is_playing_original || root.is_playing_filtered) ? 250ms : 1s;
        running: true;
        triggered => {
            root.poll_daemon_state();
        }
    }

    VerticalLayout {
        AppBar {
            // Derived, not pushed from Rust, for the same reason as the
            // color below: Rust writes one flag and the presentation stays
            // in one place. The mic really is up while reconnecting, so
            // mic_enabled stays true and the footer keeps offering Disable.
            status_text: root.reconnecting ? "Reconnecting" : root.status_text;
            status_color: root.reconnecting
                ? Theme.warn
                : (root.mic_enabled ? Theme.ok : Theme.text_muted);
            mic_enabled: root.mic_enabled;
            // Derived in Slint so the ~20 Rust error sites keep writing one
            // string and nothing else: error_text stays the single store.
            has_error: root.error_text != "";
            open_url(url) => {
                root.open_url(url);
            }
            help_clicked => {
                root.show_help_popup = true;
            }
            error_chip_clicked => {
                root.error_chip_clicked();
            }
        }

        ThresholdBand {
            value <=> root.slider_value;
            threshold_changed(value) => {
                root.threshold_changed(value);
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            padding-top: 16px;
            padding-bottom: 16px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 16px;

            SourcePanel {
                horizontal-stretch: 1;
                devices: root.input_devices;
                current_index <=> root.selected_input_index;
                selection_changed(idx) => {
                    root.selected_input_index_changed(idx);
                }
                refresh_clicked => {
                    root.refresh_devices_clicked();
                }
                device_help_clicked => {
                    root.show_device_help_popup = true;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 16px;

                MicNameCard {
                    vertical-stretch: 0;
                    default_mic_name: root.default_mic_name;
                    mic_name_text <=> root.mic_name_text;
                    invalid_flash <=> root.mic_name_invalid_flash;
                    rename_clicked(name) => {
                        root.rename_clicked(name);
                    }
                    reset_clicked(name) => {
                        root.reset_clicked(name);
                    }
                    mic_name_text_changed(text) => {
                        root.mic_name_text_changed(text);
                    }
                }

                ProcessingCard {
                    vertical-stretch: 1;
                    rumble_filter <=> root.rumble_filter;
                    auto_level <=> root.auto_level;
                    rumble_filter_changed(checked) => {
                        root.rumble_filter_changed(checked);
                    }
                    auto_level_changed(checked) => {
                        root.auto_level_changed(checked);
                    }
                }

                VoiceTestCard {
                    vertical-stretch: 0;
                    mic_enabled: root.mic_enabled;
                    is_recording <=> root.is_recording;
                    has_recording <=> root.has_recording;
                    is_playing_original <=> root.is_playing_original;
                    is_playing_filtered <=> root.is_playing_filtered;
                    recording_countdown <=> root.recording_countdown;
                    start_recording => {
                        root.start_recording();
                    }
                    stop_recording => {
                        root.stop_recording();
                    }
                    play_original => {
                        root.play_original();
                    }
                    stop_original => {
                        root.stop_original();
                    }
                    play_filtered => {
                        root.play_filtered();
                    }
                    stop_filtered => {
                        root.stop_filtered();
                    }
                }
            }
        }

        Footer {
            mic_enabled: root.mic_enabled;
            is_recording: root.is_recording;
            unsaved_changes: root.unsaved_changes;
            enable_clicked => {
                root.enable_clicked();
            }
            disable_clicked => {
                root.disable_clicked();
            }
        }
    }

    if root.show_device_help_popup: DeviceHelpPopup {
        width: parent.width;
        height: parent.height;
        close_clicked => {
            root.show_device_help_popup = false;
        }
    }

    if root.show_help_popup: HelpPopup {
        width: parent.width;
        height: parent.height;
        close_clicked => {
            root.show_help_popup = false;
        }
    }

    if root.show_error_popup: ErrorPopup {
        width: parent.width;
        height: parent.height;
        error_text: root.error_text;
        diagnostics_text: root.diagnostics_text;
        close_clicked => {
            root.show_error_popup = false;
        }
    }
}
