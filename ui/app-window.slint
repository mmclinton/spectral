import {
    Slider,
    Button,
    LineEdit,
    ListView,
    StandardListView,
    Switch,
    ScrollView,
} from "std-widgets.slint";
import { SectionHeader } from "section-headers.slint";
import { ClickableLink } from "links.slint";

export component MainWindow inherits Window {
    title: "Spectral";
    // JetBrains Mono is provided via fontconfig wrapper in Nix builds
    default-font-family: "JetBrains Mono";
    min-width: 920px;
    min-height: 800px;
    background: #0D1117;

    property <string> default_mic_name: "Spectral-Mic";
    in-out property <string> mic_name_text: "Spectral-Mic";
    in-out property <int> selected_input_index: -1;
    in-out property <[StandardListViewItem]> input_devices;
    in-out property <int> slider_value: 50;
    in-out property <bool> rumble_filter: false;
    in-out property <bool> auto_level: false;
    in-out property <bool> is_recording: false;
    in-out property <bool> has_recording: false;
    in-out property <bool> is_playing_original: false;
    in-out property <bool> is_playing_filtered: false;
    in-out property <int> recording_countdown: 0;
    in-out property <string> status_text: "Status: Inactive";
    in-out property <color> status_color: #FF0000;
    in-out property <string> error_text: "";
    in-out property <bool> mic_enabled: false;
    in-out property <bool> show_device_help_popup: false;
    in-out property <bool> show_help_popup: false;
    in-out property <bool> mic_name_invalid_flash: false;

    callback selected_input_index_change(int);
    callback threshold_change(int);
    callback rumble_filter_change(bool);
    callback auto_level_change(bool);
    callback rename_clicked(string);
    callback reset_clicked(string);
    callback enable_clicked();
    callback disable_clicked();
    callback mic_name_text_changed(string);
    callback refresh_devices_clicked();
    callback open_url(string);
    callback start_recording();
    callback stop_recording();
    callback play_original();
    callback stop_original();
    callback play_filtered();
    callback stop_filtered();
    callback poll_daemon_state();

    // Always-on daemon reconcile: 1s heartbeat, 250ms while playback
    // glyphs need snappy updates
    Timer {
        interval: (root.is_playing_original || root.is_playing_filtered) ? 250ms : 1s;
        running: true;
        triggered => {
            root.poll_daemon_state();
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;

        Rectangle {
            x: ((parent.width / 2) - (self.width / 2));
            y: 0px;
            width: 920px;
            height: 760px;
            background: #0D1117;

            ClickableLink {
                x: 50px;
                y: 20px;
                text: "Source Code";
                clicked => {
                    root.open_url("https://codeberg.org/mmc/spectral");
                }
            }

            ClickableLink {
                x: 50px;
                y: 40px;
                text: "License";
                clicked => {
                    root.open_url("https://codeberg.org/mmc/spectral/src/commit/HEAD/LICENSE");
                }
            }

            ClickableLink {
                x: 50px;
                y: 60px;
                text: "Help";
                clicked => {
                    root.show_help_popup = true;
                }
            }

            // Status bar
            Rectangle {
                x: ((parent.width / 2) - (self.width / 2));
                y: 20px;
                width: 330px;
                height: 40px;
                background: #161B22;
                border-color: root.status_color;
                border-width: 1px;
                border-radius: 4px;

                Text {
                    width: parent.width;
                    height: 30px;
                    text: root.status_text;
                    font-size: 18px;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Error line under the status bar
            if root.error_text != "": Text {
                x: ((parent.width / 2) - (self.width / 2));
                y: 64px;
                width: 600px;
                height: 20px;
                text: root.error_text;
                font-size: 12px;
                color: #FF4444;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            // Input Threshold label
            Text {
                x: ((parent.width / 2) - (self.width / 2));
                y: 110px;
                width: 175px;
                height: 30px;
                text: "Input Threshold";
                font-size: 16px;
                font-weight: 700;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Slider
            slider := Slider {
                x: ((parent.width / 2) - (self.width / 2));
                y: 140px;
                width: 535px;
                height: 50px;
                value: root.slider_value;
                minimum: 0;
                maximum: 100;
                changed(value) => {
                    root.slider_value = value;
                    // Don't auto-apply - the GUI recomputes its local pending status
                    root.threshold_change(value)
                }
            }

            // Threshold value
            Text {
                x: (((parent.width / 2) - (self.width / 2)) + (slider.width / 2) + (self.width / 2)); //cursed placement
                y: 150px;
                width: 60px;
                height: 30px;
                text: "\{slider_value}%";
                font-size: 18px;
                font-weight: 700;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Left section: Original Input Source
            Rectangle {
                x: 50px;
                y: 210px;
                width: 380px;
                height: 460px;
                background: #161B22;
                border-color: #30363D;
                border-width: 1px;
                border-radius: 4px;

                // Header
                SectionHeader {
                    x: 10px;
                    y: 10px;
                    title: "Original Input Source";
                }

                // List background
                Rectangle {
                    x: 10px;
                    y: 50px;
                    width: 360px;
                    height: 400px;
                    background: #30363D;
                    border-color: #30363D;
                    border-width: 1px;
                    border-radius: 2px;

                    VerticalLayout {
                        padding-top: 15px;
                        padding-bottom: 25px;
                        padding-left: 5px;
                        padding-right: 5px;
                        spacing: 40px;

                        inputs_list := StandardListView {
                            model: root.input_devices;
                            current_item <=> root.selected_input_index;
                            current_item_changed => {
                                root.selected_input_index_change(self.current_item);
                            }
                        }
                    }

                    Rectangle {
                        x: 5px;
                        y: parent.height - 33px;
                        width: 98px;
                        height: 26px;
                        background: #161B22;
                        border-width: 1px;
                        border-radius: 2px;

                        Button {
                            width: 100px;
                            height: 28px;
                            text: "Refresh";
                            clicked => {
                                root.refresh_devices_clicked();
                            }
                        }
                    }

                    // Not seeing your device? 
                    device-help := Text {
                        width: parent.width - 15px;
                        height: parent.height - 15px;
                        text: "Not seeing your device?";
                        font-size: 10px;
                        font-italic: true;
                        color: #0085FC;
                        horizontal-alignment: right;
                        vertical-alignment: bottom;
                    }

                    TouchArea {
                        x: device-help.x + (345px - 140px);
                        y: device-help.y + (385px - 15px);
                        width: device-help.width - (345px - 140px);
                        height: device-help.height - (385px - 15px);
                        clicked => {
                            root.show_device_help_popup = true;
                        }
                    }
                }
            }

            // Right section: Virtual Mic Name
            Rectangle {
                x: 490px;
                y: 210px;
                width: 380px;
                height: 460px;
                background: #161B22;
                border-color: #30363D;
                border-width: 1px;
                border-radius: 4px;

                // Header
                SectionHeader {
                    x: 10px;
                    y: 10px;
                    title: "Virtual Mic Name";
                }

                // Input field with buttons
                HorizontalLayout {
                    x: 10px;
                    y: 50px;
                    width: 360px;
                    height: 30px;
                    spacing: 8px;

                    Rectangle {
                        horizontal-stretch: 1;
                        background: #30363D;
                        border-color: root.mic_name_invalid_flash ? #FF4444 : #30363D;
                        border-width: root.mic_name_invalid_flash ? 2px : 1px;
                        border-radius: 5px;
                        clip: true;

                        Timer {
                            interval: 400ms;
                            running: root.mic_name_invalid_flash;
                            triggered => {
                                root.mic_name_invalid_flash = false;
                            }
                        }

                        mic_name := TextInput {
                            x: 10px;
                            width: max(parent.width - 20px, self.preferred-width);
                            height: parent.height;
                            text <=> root.mic_name_text;
                            font-size: 14px;
                            color: white;
                            vertical-alignment: center;
                            // TextInput never scrolls on its own; keep the cursor
                            // visible per the upstream TextInput reference pattern
                            private property <length> margin: 10px;
                            cursor-position-changed(cursor-position) => {
                                if cursor-position.x + self.x < self.margin {
                                    self.x = - cursor-position.x + self.margin;
                                } else if cursor-position.x + self.x > parent.width - self.margin - self.text-cursor-width {
                                    self.x = parent.width - cursor-position.x - self.margin - self.text-cursor-width;
                                }
                            }
                            edited() => {
                                root.mic_name_text_changed(self.text);
                            }
                        }
                    }

                    // Rename button
                    Rectangle {
                        width: 80px;
                        background: #5E5E5E;
                        border-color: #30363D;
                        border-width: 1px;

                        Button {
                            width: parent.width;
                            height: parent.height;
                            text: "Rename";
                            clicked => {
                                mic_name.clear-focus();
                                root.rename_clicked(mic_name.text);
                            }
                        }
                    }

                    // Reset button
                    Rectangle {
                        width: 64px;
                        background: #5E5E5E;
                        border-color: #30363D;
                        border-width: 1px;

                        Button {
                            width: parent.width;
                            height: parent.height;
                            text: "Reset";
                            clicked => {
                                mic_name.clear-focus();
                                if (mic_name.text != root.default_mic_name) {
                                    mic_name.text = root.default_mic_name;
                                    root.reset_clicked(root.default_mic_name);
                                }
                            }
                        }
                    }
                }

                // Voice Processing header
                SectionHeader {
                    x: 10px;
                    y: 110px;
                    title: "Voice Processing";
                }

                Switch {
                    x: 10px;
                    y: 150px;
                    height: 30px;
                    checked <=> root.rumble_filter;
                    toggled => {
                        root.rumble_filter_change(self.checked);
                    }
                }

                Text {
                    x: 70px;
                    y: 150px;
                    height: 30px;
                    text: "Rumble filter";
                    font-size: 14px;
                    color: white;
                    vertical-alignment: center;
                }

                Switch {
                    x: 10px;
                    y: 190px;
                    height: 30px;
                    checked <=> root.auto_level;
                    toggled => {
                        root.auto_level_change(self.checked);
                    }
                }

                Text {
                    x: 70px;
                    y: 190px;
                    height: 30px;
                    text: "Auto level";
                    font-size: 14px;
                    color: white;
                    vertical-alignment: center;
                }

                // Voice Test Header
                SectionHeader {
                    x: 10px;
                    y: 350px;
                    title: "Record A Voice Test";
                }

                // Recording Area
                HorizontalLayout {
                    x: 10px;
                    y: 390px;
                    width: 360px;
                    height: 60px;
                    horizontal-stretch: 0;
                    spacing: 10px;

                    // Record button
                    Button {
                        width: 100px;
                        height: 58px;
                        text: root.is_recording ? "Stop" : "Record";
                        enabled: root.mic_enabled;
                        clicked => {
                            if (root.is_playing_original) {
                                root.is_playing_original = false;
                                root.stop_original();
                            }
                            if (root.is_playing_filtered) {
                                root.is_playing_filtered = false;
                                root.stop_filtered();
                            }
                            root.is_recording = !root.is_recording;

                            if (root.is_recording) {
                                root.recording_countdown = 0;
                                root.has_recording = false;
                                root.start_recording();
                            } else {
                                root.has_recording = true;
                                root.stop_recording();
                            }
                        }
                    }

                    // Recording countdown indicator
                    if root.is_recording: Rectangle {
                        width: 240px;
                        height: 58px;
                        background: #30363D;
                        border-color: #FF4444;
                        border-width: 2px;
                        border-radius: 4px;

                        // Timer
                        Timer {
                            interval: 1s;
                            running: root.is_recording;
                            triggered => {
                                if (root.recording_countdown < 15) {
                                    root.recording_countdown = root.recording_countdown + 1;
                                } else {
                                    root.is_recording = false;
                                    root.has_recording = true;
                                    root.stop_recording();
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;

                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: 20px;
                                    background: #FF4444;

                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.recording_countdown;
                                        font-size: 18px;
                                        font-weight: 700;
                                        color: white;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Recording...";
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: #FF4444;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Playback options
                    if !root.is_recording && root.has_recording: Rectangle {
                        width: 240px;
                        height: 58px;
                        background: #30363D;
                        border-color: #30363D;
                        border-width: 1px;
                        border-radius: 4px;

                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 4px;
                            alignment: center;

                            // Original output row
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                // Play/Stop button for original
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    background: root.is_playing_original ? #FF4444 : #0085FC;
                                    border-radius: 3px;

                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.is_playing_original ? "■" : "▶";
                                        font-size: 12px;
                                        color: white;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => {
                                            if (root.is_playing_original) {
                                                root.is_playing_original = false;
                                                root.stop_original();
                                            } else {
                                                // Stop filtered if playing
                                                if (root.is_playing_filtered) {
                                                    root.is_playing_filtered = false;
                                                    root.stop_filtered();
                                                }
                                                root.is_playing_original = true;
                                                root.play_original();
                                            }
                                        }
                                    }
                                }

                                ClickableLink {
                                    text: "original_output.wav";
                                    clicked => {
                                        if (root.is_playing_original) {
                                            root.is_playing_original = false;
                                            root.stop_original();
                                        } else {
                                            if (root.is_playing_filtered) {
                                                root.is_playing_filtered = false;
                                                root.stop_filtered();
                                            }
                                            root.is_playing_original = true;
                                            root.play_original();
                                        }
                                    }
                                }
                            }

                            // Filtered output row
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                // Play/Stop button for filtered
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    background: root.is_playing_filtered ? #FF4444 : #0085FC;
                                    border-radius: 3px;

                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.is_playing_filtered ? "■" : "▶";
                                        font-size: 12px;
                                        color: white;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => {
                                            if (root.is_playing_filtered) {
                                                root.is_playing_filtered = false;
                                                root.stop_filtered();
                                            } else {
                                                if (root.is_playing_original) {
                                                    root.is_playing_original = false;
                                                    root.stop_original();
                                                }
                                                root.is_playing_filtered = true;
                                                root.play_filtered();
                                            }
                                        }
                                    }
                                }

                                ClickableLink {
                                    text: "filtered_output.wav";
                                    clicked => {
                                        if (root.is_playing_filtered) {
                                            root.is_playing_filtered = false;
                                            root.stop_filtered();
                                        } else {
                                            if (root.is_playing_original) {
                                                root.is_playing_original = false;
                                                root.stop_original();
                                            }
                                            root.is_playing_filtered = true;
                                            root.play_filtered();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Empty placeholder when no recording yet and not recording
                    if !root.is_recording && !root.has_recording: Rectangle {
                        width: 240px;
                        height: 58px;
                        background: #30363D;
                        border-color: #30363D;
                        border-width: 1px;
                        border-radius: 4px;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: root.mic_enabled ? "Press Record to start" : "Enable mic to record";
                            font-size: 12px;
                            color: #8B949E;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Disable button
            Button {
                x: 250px;
                y: 700px;
                width: 140px;
                height: 40px;
                text: "Disable";
                clicked => {
                    if (root.mic_enabled) {
                        apply.text = "Enable";
                        root.disable_clicked();
                    }
                }
            }

            // Apply button
            apply := Button {
                x: 530px;
                y: 700px;
                width: 140px;
                height: 40px;
                text: root.mic_enabled ? "Apply" : "Enable";
                clicked => {
                    root.enable_clicked();
                }
            }

            // Device troubleshooting popup overlay
            if root.show_device_help_popup: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: #0D111799; // Semi-transparent dark overlay

                // Block clicks from passing through
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.show_device_help_popup = false;
                    }
                }

                // Popup container (90% of 920x760 = 828x684)
                popup-container := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 828px;
                    height: 684px;
                    background: #161B22;
                    border-color: #30363D;
                    border-width: 2px;
                    border-radius: 8px;

                    // Prevent clicks inside popup from closing it
                    TouchArea {
                        width: 100%;
                        height: 100%;
                    }

                    // Popup header
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: 36px;
                        background: #264F78;
                        border-radius: 6px;

                        // Square off bottom corners
                        Rectangle {
                            x: 0px;
                            y: 18px;
                            width: parent.width;
                            height: 18px;
                            background: #264F78;
                        }

                        Text {
                            width: 100%;
                            height: 100%;
                            text: "Device Troubleshooting";
                            font-size: 16px;
                            font-weight: 700;
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        // Close button
                        Rectangle {
                            x: parent.width - 32px;
                            y: 4px;
                            width: 28px;
                            height: 28px;
                            background: #FF444488;
                            border-radius: 4px;

                            Text {
                                width: 100%;
                                height: 100%;
                                text: "✕";
                                font-size: 14px;
                                font-weight: 700;
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    root.show_device_help_popup = false;
                                }
                            }
                        }
                    }

                    // Scrollable content area
                    Rectangle {
                        x: 20px;
                        y: 50px;
                        width: parent.width - 40px;
                        height: parent.height - 70px;
                        background: transparent;

                        VerticalLayout {
                            spacing: 20px;
                            padding: 10px;

                            // Intro text
                            Text {
                                text: "If your microphone isn't appearing in the device list, here are some common causes and solutions:";
                                font-size: 14px;
                                color: #8B949E;
                                wrap: word-wrap;
                                horizontal-alignment: left;
                            }

                            // Scenario 1: PipeWire or WirePlumber not running
                            Rectangle {
                                height: 90px;
                                background: #0D1117;
                                border-color: #30363D;
                                border-width: 1px;
                                border-radius: 6px;

                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 8px;

                                    Text {
                                        text: "1. PipeWire or WirePlumber Not Running";
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: #0085FC;
                                    }

                                    Text {
                                        text: "Spectral needs PipeWire and its session manager. Check both: `systemctl --user status pipewire wireplumber`";
                                        font-size: 13px;
                                        color: #C9D1D9;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Scenario 2: Device not connected
                            Rectangle {
                                height: 90px;
                                background: #0D1117;
                                border-color: #30363D;
                                border-width: 1px;
                                border-radius: 6px;

                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 8px;

                                    Text {
                                        text: "2. Device Not Connected or Powered Off";
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: #0085FC;
                                    }

                                    Text {
                                        text: "Check the cable, pairing, and power, then run `wpctl status` — if the device isn't listed under Sources there, PipeWire can't see it.";
                                        font-size: 13px;
                                        color: #C9D1D9;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Scenario 3: Bluetooth profile
                            Rectangle {
                                height: 90px;
                                background: #0D1117;
                                border-color: #30363D;
                                border-width: 1px;
                                border-radius: 6px;

                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 8px;

                                    Text {
                                        text: "3. Bluetooth Headset in the Wrong Profile";
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: #0085FC;
                                    }

                                    Text {
                                        text: "Bluetooth mics only capture in the HSP/HFP headset profile; A2DP is playback-only. Switch the profile in your sound settings or `pavucontrol`.";
                                        font-size: 13px;
                                        color: #C9D1D9;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Scenario 4: Device disabled or muted
                            Rectangle {
                                height: 90px;
                                background: #0D1117;
                                border-color: #30363D;
                                border-width: 1px;
                                border-radius: 6px;

                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 8px;

                                    Text {
                                        text: "4. Device Disabled or Muted";
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: #0085FC;
                                    }

                                    Text {
                                        text: "Check your system's sound settings or `pavucontrol`: the device may be muted, disabled, or its profile set to Off.";
                                        font-size: 13px;
                                        color: #C9D1D9;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Scenario 5: Stale devices after a PipeWire restart
                            Rectangle {
                                height: 90px;
                                background: #0D1117;
                                border-color: #30363D;
                                border-width: 1px;
                                border-radius: 6px;

                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 8px;

                                    Text {
                                        text: "5. Stale Devices After a PipeWire Restart";
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: #0085FC;
                                    }

                                    Text {
                                        text: "After a PipeWire restart the list may point at devices that no longer exist. Click Refresh and re-select your device before enabling.";
                                        font-size: 13px;
                                        color: #C9D1D9;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Tip at the bottom
                            Rectangle {
                                height: 50px;
                                background: #0D1117;
                                border-color: #58A6FF;
                                border-width: 1px;
                                border-radius: 6px;

                                HorizontalLayout {
                                    padding: 12px;
                                    spacing: 8px;

                                    Text {
                                        text: "Tip: After addressing any of these issues, click the Refresh button to rescan for devices.";
                                        font-size: 13px;
                                        font-italic: true;
                                        color: #58A6FF;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Help popup overlay
            if root.show_help_popup: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: #0D111799; // Semi-transparent dark overlay

                // Block clicks from passing through
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.show_help_popup = false;
                    }
                }

                // Popup container (90% of 920x760 = 828x684)
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 828px;
                    height: 684px;
                    background: #161B22;
                    border-color: #30363D;
                    border-width: 2px;
                    border-radius: 8px;

                    // Prevent clicks inside popup from closing it
                    TouchArea {
                        width: 100%;
                        height: 100%;
                    }

                    // Popup header
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: 36px;
                        background: #264F78;
                        border-radius: 6px;

                        // Square off bottom corners
                        Rectangle {
                            x: 0px;
                            y: 18px;
                            width: parent.width;
                            height: 18px;
                            background: #264F78;
                        }

                        Text {
                            width: 100%;
                            height: 100%;
                            text: "Help";
                            font-size: 16px;
                            font-weight: 700;
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        // Close button
                        Rectangle {
                            x: parent.width - 32px;
                            y: 4px;
                            width: 28px;
                            height: 28px;
                            background: #FF444488;
                            border-radius: 4px;

                            Text {
                                width: 100%;
                                height: 100%;
                                text: "✕";
                                font-size: 14px;
                                font-weight: 700;
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    root.show_help_popup = false;
                                }
                            }
                        }
                    }

                    // Scrollable content area
                    ScrollView {
                        x: 20px;
                        y: 50px;
                        width: parent.width - 40px;
                        height: parent.height - 70px;

                        VerticalLayout {
                            spacing: 16px;
                            padding: 10px;

                            // Getting Started
                            Rectangle {
                                height: 120px;
                                background: #0D1117;
                                border-color: #30363D;
                                border-width: 1px;
                                border-radius: 6px;

                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 8px;

                                    Text {
                                        text: "Getting Started";
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: #0085FC;
                                    }

                                    Text {
                                        text: "1. Select your physical microphone from the \"Original Input Source\" list\n2. Click \"Enable\" — Spectral creates the virtual mic and makes it the default input\n3. Apps that pin a specific device: select the virtual mic by the name set below";
                                        font-size: 13px;
                                        color: #C9D1D9;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Input Threshold
                            Rectangle {
                                height: 250px;
                                background: #0D1117;
                                border-color: #30363D;
                                border-width: 1px;
                                border-radius: 6px;

                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 8px;

                                    Text {
                                        text: "Input Threshold";
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: #0085FC;
                                    }

                                    Text {
                                        text: "Your microphone audio is always denoised. For every 10 ms frame, the denoiser also reports its confidence that the frame contains voice; the slider sets how much confidence the gate demands before it opens. The gate looks 20 ms ahead so word onsets stay intact, holds for 200 ms after you stop so natural pauses survive, then fades to a quiet −20 dB floor instead of muting. At 0% the gate is off — denoising only. Use \"Apply\" to save changes while the mic is active.";
                                        font-size: 13px;
                                        color: #C9D1D9;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: "0%          25%          50%          75%         100%\n●────────────┼────────────●────────────┼────────────●\noff                    default                 strict\n(denoise only) ← opens easily · demands clear voice →";
                                        font-size: 13px;
                                        color: #C9D1D9;
                                        wrap: no-wrap;
                                    }
                                }
                            }

                            // Virtual Mic Name
                            Rectangle {
                                height: 85px;
                                background: #0D1117;
                                border-color: #30363D;
                                border-width: 1px;
                                border-radius: 6px;

                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 8px;

                                    Text {
                                        text: "Virtual Mic Name";
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: #0085FC;
                                    }

                                    Text {
                                        text: "Rename and Reset only stage a new name — nothing changes until you click Enable (or Apply while active), which recreates the virtual mic under the staged name.";
                                        font-size: 13px;
                                        color: #C9D1D9;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Rumble Filter
                            Rectangle {
                                height: 190px;
                                background: #0D1117;
                                border-color: #30363D;
                                border-width: 1px;
                                border-radius: 6px;

                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 8px;

                                    Text {
                                        text: "Rumble Filter";
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: #0085FC;
                                    }

                                    Text {
                                        text: "A rumble filter removes low-frequency energy that sits below the human voice — desk thumps, handling noise, HVAC and traffic rumble. Spectral applies a 2nd-order Butterworth high-pass at 90 Hz ahead of the denoiser, so RNNoise analyzes an already-cleaner frame. These are the conventional values: 90 Hz sits below typical voice fundamentals yet above the mains-hum harmonic region, and the Butterworth alignment is maximally flat, so deep rumble falls away at 12 dB per octave while voices keep their body. Consider enabling it if your mic picks up desk vibration, footsteps, or a persistent low hum.";
                                        font-size: 13px;
                                        color: #C9D1D9;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Auto Level
                            Rectangle {
                                height: 205px;
                                background: #0D1117;
                                border-color: #30363D;
                                border-width: 1px;
                                border-radius: 6px;

                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 8px;

                                    Text {
                                        text: "Auto Level";
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: #0085FC;
                                    }

                                    Text {
                                        text: "Auto leveling rides your microphone gain so your voice arrives at a consistent loudness whether you lean in or sit back. Spectral tracks speech loudness toward −18 dBFS — the common speech mix level — cutting fast at 12 dB/s and boosting slowly at 3 dB/s within a −12/+18 dB window, with an instant-attack peak limiter at −1 dBFS as the safety ceiling. These follow AGC convention: fast cuts tame sudden loudness in under a second; slow boosts avoid pumping up room noise during quiet passages. Adaptation is frozen while you are not speaking, so silence is never amplified. Consider enabling it if your distance to the mic varies or apps say you are too quiet.";
                                        font-size: 13px;
                                        color: #C9D1D9;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Voice Test
                            Rectangle {
                                height: 100px;
                                background: #0D1117;
                                border-color: #30363D;
                                border-width: 1px;
                                border-radius: 6px;

                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 8px;

                                    Text {
                                        text: "Voice Test";
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: #0085FC;
                                    }

                                    Text {
                                        text: "Record a short sample (up to 15 seconds) to compare the original and filtered audio and fine-tune the threshold. Recordings are saved under ~/.local/state/spectral/recordings.";
                                        font-size: 13px;
                                        color: #C9D1D9;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
