import {
    Slider,
    Button,
    LineEdit,
    ListView,
    StandardListView,
} from "std-widgets.slint";
import { SectionHeader } from "section-headers.slint";
import { ClickableLink } from "links.slint";

export component MainWindow inherits Window {
    title: "Spectral";
    default-font-family: "Berkeley Mono";
    min-width: 920px;
    min-height: 800px;
    background: #0D1117;

    property <string> default_mic_name: "Spectral-Mic";
    in-out property <string> mic_name_text: "Spectral-Mic";
    property <int> selected_input_index: -1;
    in-out property <[StandardListViewItem]> input_devices;
    in-out property <int> slider_value: 80;
    in-out property <bool> is_recording: false;
    in-out property <bool> has_recording: false;
    in-out property <bool> is_playing: false;
    in-out property <string> status_text: "Status: Inactive";
    in-out property <color> status_color: #FF0000;

    callback selected_input_index_change(int);
    callback threshold_change(int);
    callback rename_clicked(string);
    callback reset_clicked(string);
    callback enable_clicked();
    callback disable_clicked();
    callback mic_name_text_changed(string);

    Rectangle {
        width: parent.width;
        height: parent.height;

        Rectangle {
            x: ((parent.width / 2) - (self.width / 2));
            y: 0px;
            width: 920px;
            height: 760px;
            background: #0D1117;

            ClickableLink {
                x: 50px;
                y: 20px;
                text: "Source Code";
                clicked => {
                    debug("Open Source Code");
                }
            }

            ClickableLink {
                x: 50px;
                y: 40px;
                text: "License";
                clicked => {
                    debug("Open License");
                }
            }

            ClickableLink {
                x: 50px;
                y: 60px;
                text: "Help";
                clicked => {
                    debug("Open Help");
                }
            }

            // Status bar
            Rectangle {
                x: ((parent.width / 2) - (self.width / 2));
                y: 20px;
                width: 330px;
                height: 40px;
                background: #161B22;
                border-color: root.status_color;
                border-width: 1px;
                border-radius: 4px;

                Text {
                    width: parent.width;
                    height: 30px;
                    text: root.status_text;
                    font-size: 18px;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Input Threshold label
            Text {
                x: ((parent.width / 2) - (self.width / 2));
                y: 110px;
                width: 175px;
                height: 30px;
                text: "Input Threshold";
                font-size: 16px;
                font-weight: 700;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Slider
            slider := Slider {
                x: ((parent.width / 2) - (self.width / 2));
                y: 140px;
                width: 535px;
                height: 50px;
                value: root.slider_value;
                minimum: 0;
                maximum: 100;
                changed(value) => {
                    root.slider_value = value;
                    if (root.status_color == #3FB950) {
                        root.threshold_change(value)
                    }
                }
            }

            // Threshold value
            Text {
                x: (((parent.width / 2) - (self.width / 2)) + (slider.width / 2) + (self.width / 2)); //cursed placement
                y: 150px;
                width: 60px;
                height: 30px;
                text: "\{slider_value}%";
                font-size: 18px;
                font-weight: 700;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Left section: Original Input Source
            Rectangle {
                x: 50px;
                y: 210px;
                width: 380px;
                height: 460px;
                background: #161B22;
                border-color: #30363D;
                border-width: 1px;
                border-radius: 4px;

                // Header
                SectionHeader {
                    x: 10px;
                    y: 10px;
                    title: "Original Input Source";
                }

                // List background
                Rectangle {
                    x: 10px;
                    y: 50px;
                    width: 360px;
                    height: 400px;
                    background: #30363D;
                    border-color: #30363D;
                    border-width: 1px;
                    border-radius: 2px;

                    VerticalLayout {
                        padding-top: 15px;
                        padding-bottom: 25px;
                        padding-left: 5px;
                        padding-right: 5px;
                        spacing: 40px;

                        inputs_list := StandardListView {
                            model: root.input_devices;
                            current_item <=> root.selected_input_index;
                            current_item_changed => {
                                root.selected_input_index_change(self.current_item);
                            }
                        }
                    }

                    Rectangle {
                        x: 5px;
                        y: parent.height - 33px;
                        width: 98px;
                        height: 26px;
                        background: #161B22;
                        border-width: 1px;
                        border-radius: 2px;

                        Button {
                            width: 100px;
                            height: 28px;
                            text: "Refresh";
                            clicked => {
                                debug("Refresh input devices");
                            }
                        }
                    }

                    // Not seeing your device? 
                    device-help := Text {
                        width: parent.width - 15px;
                        height: parent.height - 15px;
                        text: "Not seeing your device?";
                        font-size: 10px;
                        font-italic: true;
                        color: #0085FC;
                        horizontal-alignment: right;
                        vertical-alignment: bottom;
                    }

                    TouchArea {
                        x: device-help.x + (345px - 140px);
                        y: device-help.y + (385px - 15px);
                        width: device-help.width - (345px - 140px);
                        height: device-help.height - (385px - 15px);
                        clicked => {
                            debug("Open device troubleshooting");
                        }
                    }
                }
            }

            // Right section: Virtual Mic Name
            Rectangle {
                x: 490px;
                y: 210px;
                width: 380px;
                height: 460px;
                background: #161B22;
                border-color: #30363D;
                border-width: 1px;
                border-radius: 4px;

                // Header
                SectionHeader {
                    x: 10px;
                    y: 10px;
                    title: "Virtual Mic Name";
                }

                // Input field with buttons
                Rectangle {
                    x: 10px;
                    y: 50px;
                    width: 360px;
                    height: 30px;
                    background: #30363D;
                    border-color: #30363D;
                    border-width: 1px;
                    border-radius: 5px;

                    mic_name := TextInput {
                        x: 15px;
                        y: 0px;
                        height: 30px;
                        text <=> root.mic_name_text;
                        font-size: 14px;
                        color: white;
                        vertical-alignment: center;
                        edited() => {
                            root.mic_name_text_changed(self.text);
                        }
                    }

                    // Rename button
                    Rectangle {
                        x: 200px;
                        y: 0px;
                        width: 89px;
                        height: 30px;
                        background: #5E5E5E;
                        border-color: #30363D;
                        border-width: 1px;

                        Button {
                            width: parent.width;
                            height: parent.height;
                            text: "Rename";
                            clicked => {
                                mic_name.clear-focus();
                                root.rename_clicked(mic_name.text);
                            }
                        }
                    }

                    // Reset button
                    Rectangle {
                        x: 288px;
                        y: 0px;
                        width: 72px;
                        height: 30px;
                        background: #5E5E5E;
                        border-color: #30363D;
                        border-width: 1px;

                        Button {
                            width: parent.width;
                            height: parent.height;
                            text: "Reset";
                            clicked => {
                                mic_name.clear-focus();
                                if (mic_name.text != root.default_mic_name) {
                                    mic_name.text = root.default_mic_name;
                                    root.reset_clicked(root.default_mic_name);
                                }
                            }
                        }
                    }
                }

                // Voice Test Header
                SectionHeader {
                    x: 10px;
                    y: 350px;
                    title: "Record A Voice Test";
                }

                // Recording Area
                HorizontalLayout {
                    x: 10px;
                    y: 390px;
                    width: 360px;
                    height: 60px;
                    horizontal-stretch: 0;

                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 2px;
                        padding-right: 10px;

                        // Record button
                        Button {
                            width: 100px;
                            height: 28px;
                            text: root.is_recording ? "Stop" : "Record";
                            clicked => {
                                if (root.is_playing) {
                                    root.is_playing = false;
                                    debug("Stopped playback before starting new recording");
                                }
                                root.is_recording = !root.is_recording;

                                if (root.is_recording) {
                                    debug("Start recording");
                                    root.has_recording = false;
                                } else {
                                    debug("Stop recording");
                                    root.has_recording = true;
                                }
                            }
                        }

                        // Play button
                        Button {
                            width: 100px;
                            height: 28px;
                            text: root.is_playing ? "Stop" : "Play";
                            enabled: root.has_recording && !root.is_recording;
                            clicked => {
                                if (root.is_playing) {
                                    root.is_playing = false;
                                    debug("Stop playback");
                                } else {
                                    root.is_playing = true;
                                    debug("Play recording");
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 250px;
                        height: 60px;
                        background: #30363D;
                        border-color: #30363D;
                        border-width: 1px;
                    }
                }
            }

            // Disable button
            Button {
                x: 250px;
                y: 700px;
                width: 140px;
                height: 40px;
                text: "Disable";
                clicked => {
                    if (root.status_color != #FF0000) {
                        apply.text = "Enable";
                        root.disable_clicked();
                    }
                }
            }

            // Apply button
            apply := Button {
                x: 530px;
                y: 700px;
                width: 140px;
                height: 40px;
                text: "Enable";
                clicked => {
                    if (root.status_color == #FF0000) {
                        self.text = "Apply"
                    }
                    if (root.status_color != #3FB950) {
                        root.enable_clicked();
                    }
                }
            }
        }
    }
}
