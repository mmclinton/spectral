export component SelectableInputItem {
    in property <string> label;
    in property <int> index;
    in-out property <int> selected_input_index: -1;  
    callback select(int); 

    Rectangle {
        width: (parent.width - 20px);
        height: 30px;
        vertical-stretch: 0;
        background: root.selected_input_index == root.index ? #6E6E6E : transparent;

        Text {
            x: 10px;
            height: 100%;
            text: root.label;
            font-size: 14px;
            color: root.selected_input_index == root.index ? white : (root.selected_input_index != -1 ? #D6D6D6 : white);
            vertical-alignment: center;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.select(root.index); }
        }
    }
}
